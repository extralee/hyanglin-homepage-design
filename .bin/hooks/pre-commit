#!/usr/bin/env bash
# =============================================================================
# Git pre-commit hook
# 목적: 신규 향린 홈페이지(hyanglin-26) 관련 작업이 hyanglin-legacy에 혼입되는 것을 차단
# =============================================================================

# 스테이징된 파일 목록 가져오기
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

BLOCKED_FILES=""

# Longest match first ERE 패턴: 신규 디자인 및 프로토타입 경로/파일명
PATTERN="(^prototype/|^patches/new_design/|신규디자인시안|신규디자인|디자인시안|신규시안|프로토타입|prototype|new_design)"

while IFS= read -r file; do
    [ -z "$file" ] && continue
    if echo "$file" | grep -qiE "$PATTERN"; then
        BLOCKED_FILES="${BLOCKED_FILES}\n  • $file"
    fi
done <<< "$STAGED_FILES"

if [ -n "$BLOCKED_FILES" ]; then
    echo "================================================================"
    echo "❌ [Commit Rejected] 신규 향린 홈페이지 및 프로토타입/디자인 작업은"
    echo "   'hyanglin-26' 레포지토리에서 진행해야 합니다!"
    echo "   저장소 경로: /home/hyuk/prj/hyanglin/hyanglin-26"
    echo "----------------------------------------------------------------"
    echo -e "차단된 파일 목록:$BLOCKED_FILES"
    echo "----------------------------------------------------------------"
    echo "위 파일들을 hyanglin-26 레포지토리로 이동하여 커밋해 주세요."
    echo "================================================================"
    exit 1
fi

exit 0
