#!/bin/sh

# 글로벌 pre-commit 훅 (Husky)
# 🔧 [CUSTOMIZE] 프로젝트에 복사한 후 ALLOWED_ROOT 목록을 프로젝트에 맞게 수정하라.

PROJECT_ROOT=$(git rev-parse --show-toplevel)

# ─── 1. Supply-chain IoC Guard ───────────────────────────────────────
# 빌드 설정 파일 오염 여부를 커밋 전에 차단한다.
if [ -f "$PROJECT_ROOT/.bin/local-security-guard.sh" ]; then
  if ! bash "$PROJECT_ROOT/.bin/local-security-guard.sh"; then
    echo "❌ [Security Gate] IoC 스캔 실패 — 커밋을 차단합니다."
    exit 1
  fi
fi

# ─── 2. Harness Deterministic Gate ───────────────────────────────────
# any 타입 금지, 보안 패턴, 임시 파일 등 정적 게이트 검사
# ⚠️ harness-check.sh에 any 3패턴(: any, as any, <any>) 검사가 포함되어 있으므로
#    pre-commit에 별도 any 가드를 중복 작성하지 않는다 (DRY).
if [ -f "$PROJECT_ROOT/.bin/harness-check.sh" ]; then
  if ! bash "$PROJECT_ROOT/.bin/harness-check.sh"; then
    echo "❌ [Harness Gate] 정적 게이트 검사 실패 — 커밋을 차단합니다."
    exit 1
  fi
fi

# ─── 3. Package Manager Gate ──────────────────────────────────────────
# 🔧 [CUSTOMIZE] 프로젝트에서 사용하는 패키지 매니저에 맞게 수정하세요.
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

if echo "$STAGED" | grep -q "package-lock.json"; then
  echo "❌ [PM Gate] package-lock.json 커밋 차단! pnpm을 사용하세요."
  exit 1
fi

if echo "$STAGED" | grep -q "yarn.lock"; then
  echo "❌ [PM Gate] yarn.lock 커밋 차단! pnpm을 사용하세요."
  exit 1
fi

# ─── 4. Master Branch Deprecation Guard ──────────────────────────────
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" = "master" ]; then
  echo "❌ [ERROR] 'master' 브랜치는 더 이상 사용되지 않습니다."
  echo "    git branch -m master main"
  exit 1
fi

# ─── 5. Gitleaks Secret Scan (설치된 경우에만) ───────────────────────
# 🔧 [CUSTOMIZE] .gitleaks.toml 설정 파일을 프로젝트에 맞게 작성하세요.
if command -v gitleaks >/dev/null 2>&1; then
  GITLEAKS_OPTS="--staged --redact"
  if [ -f "$PROJECT_ROOT/.gitleaks.toml" ]; then
    GITLEAKS_OPTS="$GITLEAKS_OPTS --config $PROJECT_ROOT/.gitleaks.toml"
  fi
  if ! gitleaks protect $GITLEAKS_OPTS; then
    echo "❌ [Secret Scan] 시크릿(자격증명) 유출이 감지되어 커밋을 차단합니다."
    exit 1
  fi
else
  echo "ℹ️  gitleaks 미설치 — 시크릿 검사를 건너뜁니다. (권장: https://github.com/gitleaks/gitleaks)"
fi

# ─── 6. 루트 폴더 허용 목록 정책 ─────────────────────────────────────
# 🔧 [CUSTOMIZE] 프로젝트의 루트 파일에 맞게 수정하세요.
ALLOWED_ROOT="
.agent
.agents
.antigravitycli
.bin
.env.example
.envrc
.gitattributes
.github
.gitignore
.gitleaks.toml
.husky
AGENT.md
AGENTS.md
README.md
docs
frontend
backend
tmp
"

NEW_ROOT_FILES=$(git diff --cached --name-only --diff-filter=A | grep -v "/" | grep -v "^$" || true)

if [ -n "$NEW_ROOT_FILES" ]; then
  UNEXPECTED=""
  for file in $NEW_ROOT_FILES; do
    if ! echo "$ALLOWED_ROOT" | grep -qxF "$file"; then
      UNEXPECTED="$UNEXPECTED
   - $file"
    fi
  done

  if [ -n "$UNEXPECTED" ]; then
    echo ""
    echo "⚠️  루트 폴더에 허용 목록에 없는 새 파일이 감지되었습니다:$UNEXPECTED"
    echo ""
    echo "   의도한 추가라면 .husky/pre-commit 의 ALLOWED_ROOT 목록에도 추가하세요."

    # 비대화형 환경 감지 (AI 에이전트/CI)
    if [ "$ALLOW_NEW_ROOT_FILES" = "1" ]; then
      echo "✅ ALLOW_NEW_ROOT_FILES=1 — 허용 목록 검사를 건너뛰고 커밋을 계속합니다."
    elif ! answer=$( { read -r a < /dev/tty && printf %s "$a"; } 2>/dev/null ); then
      echo ""
      echo "❌ [비대화형 환경] 확인을 받을 수 없어 커밋을 차단합니다."
      echo "   해결: ALLOWED_ROOT에 추가하거나 ALLOW_NEW_ROOT_FILES=1 git commit ..."
      exit 1
    else
      if [ "$answer" != "y" ] && [ "$answer" != "Y" ]; then
        echo "❌ 커밋이 취소되었습니다."
        exit 1
      fi
      echo "✅ 확인됨. 커밋을 계속합니다."
    fi
  fi
fi
